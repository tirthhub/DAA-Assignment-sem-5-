# 74-SEARCH A 2D MATRIX

class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int row = matrix.length;
        int cols = matrix[0].length;

        int low = 0;
        int high = row * cols - 1;
        while(low<=high){
            int mid = low + (high-low)/2;
            int x = mid / cols;
            int y = mid % cols;

            if(matrix[x][y]== target){
                return true;
            }
            if(matrix[x][y]>target){
                high = mid -1;
            }
            if(matrix[x][y]<target){
                low = mid +1;
            }
        }

        return false;

    }
}
